# Copy to .env and fill in. Real environment variables override this file.

NODE_ENV=production
PORT=3000
# The public address. It is printed inside every QR code, so set it before
# anyone downloads or prints one, and never change it afterwards.
BASE_URL=https://qrreview.co.uk
APP_NAME=QR Review
SUPPORT_EMAIL=support@qrreview.co.uk
# Where the database and uploaded logos live. Must be on persistent disk.
DATA_DIR=./data

# Comma-separated emails that get the admin area.
ADMIN_EMAILS=you@example.com

# Free trial length. When it ends without a plan, the QR code stops working.
TRIAL_DAYS=14

# Email (password resets, failed-payment notices). Without it, emails are
# printed to the server log instead.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=QR Review <no-reply@qrreview.co.uk>

# Stripe. Create two recurring Prices in the Stripe dashboard (monthly and
# yearly) and paste their IDs here. Leave blank to run without billing.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Display prices (should match the Stripe Prices above). Set a plan's amount
# to 0 to hide it.
PLAN_MONTHLY_AMOUNT=9.99
PLAN_ANNUAL_AMOUNT=99
CURRENCY_SYMBOL=£

# Which industry's wording the home page uses (see src/views/industries.js).
DEFAULT_INDUSTRY=trades
