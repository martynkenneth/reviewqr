# Settings. On Netlify, add these under Site configuration → Environment
# variables (see docs/SETUP.md). For local development, copy this file to .env
# — with the Supabase lines left blank the app uses local stand-ins.

# The public address. It is printed inside every QR code: never change it.
BASE_URL=https://qrreview.co.uk
APP_NAME=QR Review
SUPPORT_EMAIL=support@qrreview.co.uk
# Comma-separated emails that get the admin area.
ADMIN_EMAILS=you@example.com
# Free trial length. When it ends without a plan, the QR code stops working.
TRIAL_DAYS=14

# Supabase (Project Settings → API Keys, and Connect → Transaction pooler)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Email the app sends itself (failed-payment notices), through Google
# Workspace. Login emails are sent by Supabase (set up there).
SMTP_URL=smtps://support%40qrreview.co.uk:GOOGLE-APP-PASSWORD@smtp.gmail.com:465
MAIL_FROM=QR Review <support@qrreview.co.uk>

# Stripe. Create two recurring Prices (monthly and yearly) and paste their
# IDs. Leave blank to run without billing (the trial still works).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Display prices (should match the Stripe Prices above). 0 hides a plan.
PLAN_MONTHLY_AMOUNT=9.99
PLAN_ANNUAL_AMOUNT=99
CURRENCY_SYMBOL=£

# Which industry's wording the home page uses (see src/views/industries.js).
DEFAULT_INDUSTRY=trades
